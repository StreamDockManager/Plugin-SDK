        },
        "./authoring": {
            "types": "./dist/src/authoring.d.ts",
            "import": "./dist/src/authoring.js"
        },
        "./connectors": {
            "types": "./dist/src/connectors.d.ts",
            "import": "./dist/src/connectors.js"
        },
        "./settings": {
            "types": "./dist/src/settings.d.ts",
            "import": "./dist/src/settings.js"
        },
        "./credentials": {
            "types": "./dist/src/credentials.d.ts",
