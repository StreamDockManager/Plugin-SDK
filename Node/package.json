            "types": "./dist/src/httpclient.d.ts",
            "import": "./dist/src/httpclient.js"
        },
        "./network": {
            "types": "./dist/src/network.d.ts",
            "import": "./dist/src/network.js"
        },
        "./process": {
            "types": "./dist/src/process.d.ts",
            "import": "./dist/src/process.js"
        },
        "./workers": {
            "types": "./dist/src/workers.d.ts",
            "import": "./dist/src/workers.js"
