    "scripts": {
        "build": "node tools/clean.mjs && tsc -p tsconfig.json && node tools/assets.mjs",
        "check": "tsc -p tsconfig.json --noEmit",
        "test": "npm run build && node --test tests/*.test.mjs",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
