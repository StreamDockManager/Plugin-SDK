{
    "name": "stream-dock-manager-plugin-sdk",
    "version": "0.1.0",
    "type": "module",
    "license": "MIT",
    "engines": {
        "node": ">=22 <27"
    },
    "files": [
        "dist",
        "LICENSE",
        "README.md",
        "tools"
    ],
    "sideEffects": [
        "./dist/web/inspector-sdk.js",
